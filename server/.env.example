# ===== 环境变量模板(复制为 server/.env 使用;实值不入库,CONVENTIONS.md 红线)=====
# 运行环境:development | test | production
NODE_ENV=development

# API 服务端口
API_PORT=3000

# 日志级别:debug | info | warn | error
LOG_LEVEL=info

# PostgreSQL(本地 docker-compose 默认值;生产为阿里云 RDS 地址)
DATABASE_URL=postgresql://vr:vrmemento@localhost:5432/vrmemento?schema=public

# Redis(本地 docker-compose 默认值;生产为云数据库 Redis)
REDIS_URL=redis://localhost:6379

# JWT 会话密钥(生产必须显式改为强随机值,携带开发默认密钥将拒绝启动)
JWT_SECRET=dev-insecure-jwt-secret-change-me

# 微信开放平台移动应用(人工环节:资质办理完成后填入;留空则微信登录返回明确提示)
WECHAT_APPID=
WECHAT_SECRET=
